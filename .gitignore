# dependencies
node_modules/
# personal input data (GPX course, FIT rides) - not committed
data/
*.fit
*.gpx
# synthetic example route is safe to commit despite the *.gpx rule
!examples/sample-route.gpx
# build / cache
dist/
.cache/
weather-cache/
# env
.env
.env.*
# os
.DS_Store
# generated output (keep the directory)
output/*
!output/.gitkeep
# connect iq
ciq/bin/
ciq/developer_key.der
*.prg
# generated Monkey C source (regenerated per run; keep the directory)
ciq/source/*.mc
!ciq/source/.gitkeep
