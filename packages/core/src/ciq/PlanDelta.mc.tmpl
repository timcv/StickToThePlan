//
// PlanDelta: a sideloadable Connect IQ data field for the Vatternrundan race
// plan. It shows, in one compact value, how far ahead or behind the plan you
// are right now and your projected finish clock time.
//
// This file is GENERATED by src/ciq/generate.ts on every run so the embedded
// lookup table always matches the current plan. Do not edit the generated copy
// by hand; edit src/ciq/PlanDelta.mc.tmpl instead.
//
// Three placeholders are filled at generation time: the lookup array literal,
// the total planned time in seconds, and the start clock as seconds since
// midnight. See src/ciq/generate.ts for the exact substitutions.
//

import Toybox.Application;
import Toybox.Activity;
import Toybox.Lang;
import Toybox.WatchUi;

//! Plan-delta data field. Reads elapsed time and course distance from the
//! active activity, interpolates the planned elapsed time at the current
//! distance, and shows the signed delta plus the projected finish clock.
class PlanDeltaView extends WatchUi.SimpleDataField {

    // Lookup table of [distance_m, elapsed_s] pairs, monotonic in distance.
    private const LOOKUP = /*__LOOKUP__*/;
    // Total planned time in seconds (used for the projected finish clock).
    private const PLAN_TOTAL_S = /*__PLAN_TOTAL_S__*/;
    // Start clock in seconds since midnight (used for the projected finish).
    private const START_CLOCK_S = /*__START_CLOCK_S__*/;

    //! Constructor.
    public function initialize() {
        SimpleDataField.initialize();
        label = "Plan delta";
    }

    //! Planned elapsed seconds at a given course distance in metres, by linear
    //! interpolation over the LOOKUP table. Clamps below the first and above
    //! the last boundary.
    //! @param dist Course distance in metres
    //! @return Planned elapsed time in seconds
    private function plannedElapsedAt(dist as Float) as Float {
        var n = LOOKUP.size();
        if (n == 0) {
            return 0.0;
        }
        var firstD = LOOKUP[0][0].toFloat();
        if (dist <= firstD) {
            return LOOKUP[0][1].toFloat();
        }
        var lastD = LOOKUP[n - 1][0].toFloat();
        if (dist >= lastD) {
            return LOOKUP[n - 1][1].toFloat();
        }
        for (var i = 1; i < n; i++) {
            var d1 = LOOKUP[i][0].toFloat();
            if (dist <= d1) {
                var d0 = LOOKUP[i - 1][0].toFloat();
                var e0 = LOOKUP[i - 1][1].toFloat();
                var e1 = LOOKUP[i][1].toFloat();
                var span = d1 - d0;
                if (span <= 0.0) {
                    return e1;
                }
                var frac = (dist - d0) / span;
                return e0 + frac * (e1 - e0);
            }
        }
        return LOOKUP[n - 1][1].toFloat();
    }

    //! Format a signed second count as +M:SS or -M:SS.
    //! @param secs Signed seconds
    //! @return Compact signed minutes:seconds string
    private function fmtDelta(secs as Number) as String {
        var sign = "+";
        var a = secs;
        if (a < 0) {
            sign = "-";
            a = -a;
        }
        var mm = a / 60;
        var ss = a % 60;
        var ssStr = ss.format("%02d");
        return sign + mm.format("%d") + ":" + ssStr;
    }

    //! Format a seconds-since-midnight value as HH:MM (24 hour).
    //! @param secs Seconds since midnight (already wrapped into 0..86399)
    //! @return HH:MM string
    private function fmtClock(secs as Number) as String {
        var hh = secs / 3600;
        var mm = (secs % 3600) / 60;
        return hh.format("%02d") + ":" + mm.format("%02d");
    }

    //! Compute the displayed value once per second.
    //! @param info The updated Activity.Info object
    //! @return The compact "delta  ->finish" string
    public function compute(info as Activity.Info) as Numeric or Duration or String or Null {
        var elapsed = 0;
        if ((info has :elapsedTime) && (info.elapsedTime != null)) {
            elapsed = info.elapsedTime / 1000;
        }
        var dist = 0.0;
        if ((info has :elapsedDistance) && (info.elapsedDistance != null)) {
            dist = info.elapsedDistance;
        }
        var planned = plannedElapsedAt(dist);
        // Positive delta = behind plan, negative = ahead of plan.
        var delta = elapsed - planned;
        var projFinishS = (START_CLOCK_S + PLAN_TOTAL_S + delta).toNumber() % 86400;
        if (projFinishS < 0) {
            projFinishS += 86400;
        }
        return fmtDelta(delta.toNumber()) + "  ->" + fmtClock(projFinishS);
    }
}

//! Application entry point. A datafield app needs an AppBase whose initial view
//! is the data field itself.
class PlanDeltaApp extends Application.AppBase {

    //! Constructor.
    public function initialize() {
        AppBase.initialize();
    }

    //! Handle app startup.
    //! @param state Startup arguments
    public function onStart(state as Dictionary?) as Void {
    }

    //! Handle app shutdown.
    //! @param state Shutdown arguments
    public function onStop(state as Dictionary?) as Void {
    }

    //! Return the initial view: the plan-delta data field.
    //! @return Array [View]
    public function getInitialView() as [WatchUi.Views] or [WatchUi.Views, WatchUi.InputDelegates] {
        return [new $.PlanDeltaView()];
    }
}
